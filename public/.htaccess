<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /sobre/ redireciona para /sobre, para o Google não ver duas URLs da mesma página
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Páginas pré-renderizadas (tools/prerender.js): /sobre é servido por sobre.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Endereços que não existem recebem o status 404 de verdade (bom para o Google)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # Cache everything on CDN by default
  Header set Cache-Control "public, s-maxage=604800, max-age=0"
  
  # Cache in browser all assets
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
